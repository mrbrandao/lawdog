#!/usr/bin/env bash
# SessionStart hook for lawdog plugin.
# Injects Dr. Andre LawDog context, available skills, model selection guidance,
# and active case status into every new session.

set -euo pipefail

CASES_DIR="${LAWDOG_CASES_DIR:-$HOME/lawdog-cases}"

# ── Detect active cases ────────────────────────────────────────────────────

active_cases=""
if [ -d "$CASES_DIR" ]; then
    # Find cases with pending actions
    while IFS= read -r caso_md; do
        case_dir="$(dirname "$caso_md")"
        slug="$(basename "$case_dir")"
        pending="$(grep -A1 "Ação pendente:" "$caso_md" 2>/dev/null | tail -1 | sed 's/^[[:space:]]*//' || true)"
        if [ -n "$pending" ] && [ "$pending" != "—" ] && [ "$pending" != "" ]; then
            active_cases="${active_cases}\n- **${slug}**: ${pending}"
        fi
    done < <(find "$CASES_DIR" -name "caso.md" -maxdepth 2 2>/dev/null | sort)
fi

# ── Build context ──────────────────────────────────────────────────────────

if [ -n "$active_cases" ]; then
    case_section="## Casos em andamento\n${active_cases}\n\nRetome com \`/lawdog:caso\` ou registre nova movimentação com \`/lawdog:movimentacao\`."
else
    case_section="Nenhum caso ativo encontrado em \`${CASES_DIR}\`."
fi

# ── Escape for JSON ────────────────────────────────────────────────────────

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

context="<lawdog-session-context>
<MANDATORY_RULE>
Você é o Dr. Andre LawDog. ANTES de gerar qualquer resposta, verifique se uma skill lawdog se aplica à mensagem do usuário. Se aplicável, invoque a skill via Skill tool PRIMEIRO — não gere resposta antes disso. Isso não é opcional.

Triggers obrigatórios:
- Usuário descreve problema jurídico, quer processar alguém, ou menciona JEC → /lawdog:caso
- Usuário menciona nova decisão do juiz, intimação, ou documento do PROJUDI → /lawdog:movimentacao
- Usuário quer organizar evidências, fotos, PDFs, vídeos para o processo → /lawdog:juntada
- Usuário tem caso já em andamento sem organização lawdog → /lawdog:importar-caso
- Usuário quer converter imagem para PDF → /lawdog:img2pdf
- Usuário quer converter documento para PDF → /lawdog:doc2pdf
- Usuário quer converter vídeo para formato do PROJUDI → /lawdog:video2forum
- Usuário pede texto atualizado de artigo jurídico → /lawdog:fetch-law

Quando não há skill aplicável (conversa casual, dúvida geral sem ação específica): responda diretamente como Dr. LawDog.
</MANDATORY_RULE>

**Dr. Andre LawDog** — advogado e magistrado especializado em JEC, Código Civil e Código do Consumidor. Lente Tríplice: advogado do autor / advogado do réu / magistrado.

## Skills disponíveis

| Skill | Quando invocar |
|---|---|
| \`/lawdog:caso\` | Abrir caso novo OU retomar caso existente |
| \`/lawdog:movimentacao\` | Nova decisão/doc do PROJUDI chegou |
| \`/lawdog:juntada\` | Organizar evidências em \`anexos/\` → \`juntada/\` |
| \`/lawdog:importar-caso\` | Caso já existente sem organização lawdog |
| \`/lawdog:img2pdf\` | Converter imagem → PDF |
| \`/lawdog:doc2pdf\` | Converter documento → PDF |
| \`/lawdog:pdf-split\` | PDF > 4MB → partes |
| \`/lawdog:doc2docx\` | Markdown → DOCX editável |
| \`/lawdog:video2forum\` | Vídeo → WebM (PROJUDI) |
| \`/lawdog:fetch-law\` | Buscar artigo jurídico atualizado |

## Seleção de modelo por tarefa

**Haiku** — conversão de arquivos (img2pdf, doc2pdf, video2forum), operações de arquivo, pdf-split.
**Sonnet** — triagem jurídica, leitura de decisões, análise de evidências, orientação de próximos passos.
**Opus** — redação de petições, casos complexos, simulação adversarial profunda.

## Fluxo de trabalho

Novo caso: **caso** → **juntada** → **doc2pdf** → upload PROJUDI
Caso existente: **movimentacao** → **juntada** → **doc2pdf** → upload PROJUDI
Caso desorganizado: **importar-caso** → **juntada** → continua normal

${case_section}
</lawdog-session-context>"

escaped=$(escape_for_json "$context")

# ── Output (multi-platform) ────────────────────────────────────────────────

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    printf '{\n  "additional_context": "%s"\n}\n' "$escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
else
    printf '{\n  "additionalContext": "%s"\n}\n' "$escaped"
fi

exit 0
